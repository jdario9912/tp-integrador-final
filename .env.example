# plantilla: copiar a .env (ignorado por git) y ajustar

# URL base que usa el cliente (sin barra final)
VITE_API_URL=/api

# destino del proxy /api del servidor de desarrollo (no se expone al cliente)
# - json-server (pnpm mock:api): http://localhost:3001
# - backend real: URL del backend incluyendo el prefijo /api
API_PROXY_TARGET=http://localhost:3001

### Api
## api-gestion-deportiva
APP_NAME=

## dev
SPRING_PROFILES_ACTIVE=

## 8080
PORT=

## Zona horaria de la app: define qué fecha es "hoy" (ej. la fecha no futura de los registros de peso).
## ID IANA, no un offset fijo (por defecto, America/Argentina/Buenos_Aires)
APP_TIME_ZONE=America/Argentina/Buenos_Aires

=================================================================

### Postgres
## user
POSTGRES_USER=

## password123
POSTGRES_PASSWORD=

## gestion-deportiva
POSTGRES_DB=

## 5432
POSTGRES_PORT=

=================================================================

### JWT
## Clave de firma de los access tokens, mínimo 32 bytes. Obligatoria en prod.
## Generarla con: openssl rand -base64 32
## (con docker compose en dev, si queda vacía se usa una clave de desarrollo)
JWT_SECRET=

## 15m
JWT_ACCESS_TOKEN_TTL=

## 2h
JWT_REFRESH_TOKEN_TTL=

=================================================================

### CORS
## Orígenes del front que pueden llamar a la API, separados por coma y sin barra final. Obligatoria en prod.
## http://localhost:5173
CORS_ALLOWED_ORIGINS=

=================================================================

### Supabase Storage (fotos de progreso)
## Opcionales en dev (sin ellas el almacenamiento responde 503); obligatorias en prod.
## URL del proyecto, sin path: https://<proyecto>.supabase.co
SUPABASE_URL=

## Clave service_role del proyecto (Settings > API). Secreta: solo en .env, nunca en el repo ni en el front
SUPABASE_SERVICE_ROLE_KEY=

## Nombre del bucket privado
SUPABASE_STORAGE_BUCKET=

## 10m (vencimiento de las URLs firmadas)
STORAGE_SIGNED_URL_TTL=

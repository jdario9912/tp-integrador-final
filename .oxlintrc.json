{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "lucide-react",
            "message": "Importá los iconos desde src/ui/icons."
          },
          {
            "name": "react-router-dom",
            "message": "Importá hooks y componentes de navegación desde src/lib/navigation."
          },
          {
            "name": "react-router",
            "message": "Importá hooks y componentes de navegación desde src/lib/navigation."
          }
        ],
        "patterns": [
          {
            "group": ["lucide-react/*", "react-router/*", "react-router-dom/*"],
            "message": "Usá src/ui/icons o src/lib/navigation."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/ui/icons/index.ts", "src/lib/navigation/index.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
